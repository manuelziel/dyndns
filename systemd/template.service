[Unit]
Description={{SOFTWARE_NAME}} Service
After={{SERVICE_AFTER}}
Wants={{SERVICE_WANTS}}
PartOf={{SERVICE_PART_OF}}

[Service]
Type={{SERVICE_TYPE}}
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}
WorkingDirectory={{SHARE_DIR}}
RuntimeDirectory={{SOFTWARE_DIR_NAME}}
RuntimeDirectoryMode={{RUNTIME_DIRECTORY_MODE}}
UMask={{SERVICE_UMASK}}
SupplementaryGroups={{SERVICE_SUPPLEMENTARY_GROUPS}}
PIDFile={{SERVICE_PIDFILE}}
Environment="{{SERVICE_ENVIRONMENT}}"
ExecStart={{SERVICE_EXEC_START}}
ExecStop={{SERVICE_EXEC_STOP}}
Restart={{SERVICE_RESTART}}
RestartPreventExitStatus={{SERVICE_RESTART_PREVENT_EXIT_STATUS}}
RestartSec={{SERVICE_RESTART_SEC}}
TimeoutStartSec={{SERVICE_TIMEOUT_START_SEC}}
TimeoutStopSec={{SERVICE_TIMEOUT_STOP_SEC}}
StandardOutput={{SERVICE_STANDARD_OUTPUT}}
StandardError={{SERVICE_STANDARD_ERROR}}
StandardInput={{SERVICE_STANDARD_INPUT}}
SyslogIdentifier={{SOFTWARE_DIR_NAME}}

# Security hardening
NoNewPrivileges={{SERVICE_NO_NEW_PRIVILEGES}}
PrivateTmp={{SERVICE_PRIVATE_TMP}}
ProtectSystem={{SERVICE_PROTECT_SYSTEM}}
ProtectHome={{SERVICE_PROTECT_HOME}}
ReadWritePaths={{SERVICE_READ_WRITE_PATHS}}

[Install]
WantedBy={{SERVICE_WANTED_BY}}
